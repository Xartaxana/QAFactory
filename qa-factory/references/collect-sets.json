{
  "schema": 1,
  "note": "The closed variety of the collect packer (scripts/collect_pack.py, CL1-2; t-962 sections 2 and 3 as corrected by L-2): which files make up each set A-H, how each is taken, the ceilings, and what is never packed. Read by code only. scope p = a path under the project's qa-factory/, h = a path under one story folder (the folder named by the story key). A path may carry * (one segment) and ** (any depth). Modes: copy = the whole file through the redactor; tail = what was appended after the mark (by the prefix of its bytes); new = copy of a file that is new or changed since the mark; sum = a named summary instead of the files; index = path, bytes and sha256 only, never the content; snapshots = metrics-history.json snapshots newer than the mark; skip = not taken, with the reason. The first entry that matches a file wins. record = the file is a carried record that sits in records/ (an older factory kept it in old_paths): the answer of runtime_paths.record() is the one taken. cfg_key = the project's config may name another place for it. A file no entry names is reported as skipped, unknown file. Every p path is a row of references/install-paths.json and every h path sits under its qa-factory/artifacts/** row (test_collect_pack.py holds the two together); an entry with orphan true names files that no row knows on purpose. Scope h is held to the package's writers too: every story-scope key of references/artifact-writers.json and every path of references/artifact-registry.json resolves to an entry (test_collect_history_sets.py, CL3-3); product code is a named skip (B15), never an unknown file.",
  "limits": {"file_max_bytes": 16777216, "part_max_bytes": 25000000, "excerpt_lines": 20},
  "archive": {"prefix": "qa-collect", "out_folder": "state/collect", "temp_folder": "qa-collect", "mark": "state/collect/mark.json"},
  "set_names": {"A": "passport", "B": "run progress", "C": "money", "D": "adaptations", "E": "records", "F": "quality from the retro", "G": "dashboard data", "H": "transcripts"},
  "never_content": [
    {"glob": "state/pre-0.7.0-recovery/**", "why": "price evidence recovered by a migration; nothing reads it"},
    {"glob": "state/reporter-unread/**", "why": "reports of the product under test"},
    {"glob": "state/cost/.writers/**", "why": "lock folders"},
    {"glob": "state/collect/**", "why": "the packer's own output and mark"},
    {"glob": "**/evidence/**", "why": "run logs carry the product's data and secrets: the index only"},
    {"glob": "**/work/evidence/**", "why": "screenshots and logs of the product: the index only"},
    {"glob": "**/work/evidence-ext/**", "why": "evidence outside the repository: the index only"}
  ],
  "entries": [
    {"id": "A1", "set": "A", "scope": "p", "virtual": "passport", "mode": "sum", "sum": "passport", "always": true, "reason": "the passport: versions, host, os, python, repositories, install date, package_modified"},
    {"id": "A2", "set": "A", "scope": "p", "paths": ["state/readiness.json"], "old_paths": ["readiness.json"], "mode": "copy"},
    {"id": "A3", "set": "A", "scope": "p", "paths": ["config.json"], "mode": "copy"},
    {"id": "A4", "set": "A", "scope": "p", "paths": ["install-manifest.json"], "mode": "sum", "sum": "install_manifest"},
    {"id": "A5", "set": "A", "scope": "p", "paths": ["records/onboarding-approvals.jsonl"], "old_paths": ["state/onboarding-approvals.jsonl"], "record": true, "mode": "tail"},
    {"id": "A6", "set": "A", "scope": "p", "paths": ["state/retired/*/retire-record.json"], "mode": "new"},
    {"id": "A7", "set": "A", "scope": "p", "paths": ["strategy/project-profile.md", "strategy/aspect-profile.md", "strategy/test-strategy.md", "strategy/framework-rules.md", "strategy/faq.md"], "mode": "copy"},
    {"id": "A8", "set": "A", "scope": "p", "paths": ["state/onboarding/**"], "mode": "sum", "sum": "dir_stats"},
    {"id": "A9", "set": "A", "scope": "p", "paths": ["state/host-probe.json", "state/doctor-install-smoke-latest.json"], "mode": "copy"},
    {"id": "A10", "set": "A", "scope": "p", "paths": ["state/host-receipts/**"], "mode": "sum", "sum": "host_receipts"},
    {"id": "A11", "set": "A", "scope": "p", "paths": ["records/config-migrations/**", "state/config-migrations/**"], "mode": "skip", "reason": "the current config is in the copy; a backup of it adds nothing"},
    {"id": "A12", "set": "A", "scope": "h", "paths": ["work/briefs/repo-map-*.md"], "mode": "skip", "reason": "a map of the product's code"},
    {"id": "B1", "set": "B", "scope": "h", "paths": ["state/events.jsonl"], "mode": "tail", "events": true},
    {"id": "B2", "set": "B", "scope": "h", "paths": ["state/controller.json", "state/checkpoint.json", "state/driver-state.json", "pipeline.json"], "mode": "copy"},
    {"id": "B3", "set": "B", "scope": "h", "paths": ["state/driver-runs.jsonl", "state/conductor.jsonl", "state/driver-questions.jsonl", "state/driver-answers.jsonl", "state/dispatch-denials.jsonl"], "mode": "tail"},
    {"id": "B4", "set": "B", "scope": "p", "paths": ["records/journal.jsonl"], "old_paths": ["state/journal.jsonl"], "record": true, "cfg_key": "journal_path", "mode": "tail"},
    {"id": "B5", "set": "B", "scope": "p", "paths": ["state/dispatch-denials.jsonl"], "mode": "tail"},
    {"id": "B6", "set": "B", "scope": "h", "paths": ["state/driver-runs/*.json", "state/driver-question*.md", "state/deferred-questions/*.md", "state/words/*.txt"], "mode": "new"},
    {"id": "B7", "set": "B", "scope": "p", "paths": ["state/host-dispatches/*.json"], "mode": "new"},
    {"id": "B8", "set": "B", "scope": "p", "paths": ["state/telemetry/**"], "mode": "sum", "sum": "telemetry"},
    {"id": "B9", "set": "B", "scope": "h", "paths": ["state/execution-jobs/**", "state/environment-jobs/**", "work/run-blocks/**", "work/manual-blocks/**", "work/baseline-receipts/**"], "mode": "sum", "sum": "dir_stats"},
    {"id": "B10", "set": "B", "scope": "p", "paths": ["state/scheduler-receipts/**"], "mode": "sum", "sum": "dir_stats"},
    {"id": "B11", "set": "B", "scope": "h", "paths": ["evidence/**", "work/evidence/**", "work/evidence-ext/**"], "mode": "index", "reason": "the index of evidence: path, bytes, sha256; never the content"},
    {"id": "B12", "set": "B", "scope": "p", "paths": ["state/.exit_gate_blocks.json"], "mode": "copy"},
    {"id": "B13", "set": "B", "scope": "h", "paths": ["state/*.lock", "**/*.lock"], "mode": "skip", "reason": "lock files"},
    {"id": "B14", "set": "B", "scope": "p", "paths": ["state/**/*.lock"], "mode": "skip", "reason": "lock files"},
    {"id": "C1", "set": "C", "scope": "p", "paths": ["state/cost/.writers/**"], "mode": "skip", "reason": "lock folders"},
    {"id": "C2", "set": "C", "scope": "p", "paths": ["state/cost/*.json"], "mode": "new", "pre": "cost_transcript"},
    {"id": "C3", "set": "C", "scope": "p", "paths": ["state/turns/*.json", "state/turns/dispatches/*.json", "state/window/*.json", "state/activities/*.json"], "mode": "new"},
    {"id": "C4", "set": "C", "scope": "h", "paths": ["work/retro-numbers.json"], "mode": "copy"},
    {"id": "C5", "set": "C", "scope": "h", "paths": ["work/retro-numbers.md"], "mode": "skip", "reason": "a render of retro-numbers.json"},
    {"id": "C6", "set": "C", "scope": "p", "paths": ["records/estimation-ledger.jsonl"], "old_paths": ["state/estimation-ledger.jsonl"], "record": true, "mode": "tail"},
    {"id": "D1", "set": "D", "scope": "p", "paths": ["factory-backlog.md"], "mode": "copy"},
    {"id": "D2", "set": "D", "scope": "p", "paths": ["records/project-decisions.json"], "old_paths": ["state/project-decisions.json"], "record": true, "mode": "copy"},
    {"id": "D3", "set": "D", "scope": "p", "paths": ["records/report-adaptations.json", "records/environment-properties.json", "records/stand-identity.json", "records/project-knowledge.json"], "mode": "copy"},
    {"id": "E1", "set": "E", "scope": "h", "paths": ["work/requirements-readiness.json"], "mode": "sum", "sum": "open_questions"},
    {"id": "E2", "set": "E", "scope": "h", "paths": ["work/question-answers.jsonl"], "mode": "tail"},
    {"id": "E3", "set": "E", "scope": "p", "paths": ["obligations.md"], "mode": "copy"},
    {"id": "E4", "set": "E", "scope": "h", "paths": ["work/context-manifest.json", "work/automation-manifest.json"], "mode": "sum", "sum": "unresolved"},
    {"id": "E5", "set": "E", "scope": "p", "paths": ["bugs/BUG-*.md"], "mode": "new"},
    {"id": "E6", "set": "E", "scope": "h", "paths": ["bugs/BUG-*.md"], "mode": "new"},
    {"id": "E7", "set": "E", "scope": "h", "paths": ["understanding.md", "test-plan.md", "test-plan.json", "work/test-plan.json", "work/test-cases/**", "state/case-versions/**", "work/ledger.json", "work/ledger.md", "state/delivery-manifest.json", "state/coverage-migrations/**"], "mode": "sum", "sum": "artifacts_summary", "reason": "counts, not the product's text (F-7 a)"},
    {"id": "F1", "set": "F", "scope": "h", "paths": ["retro.md"], "mode": "copy"},
    {"id": "G1", "set": "G", "scope": "p", "paths": ["state/metrics.json", "state/metric-signals.json"], "mode": "copy"},
    {"id": "G2", "set": "G", "scope": "p", "paths": ["state/metrics-history.json"], "mode": "snapshots"},
    {"id": "G3", "set": "G", "scope": "p", "paths": ["state/factory-dashboard.html", "state/dashboard-dirty.json", "state/dashboard-refresh.json", "state/.dashboard-writer/**"], "mode": "skip", "reason": "rebuilt by the dashboard; the html carries file:/// paths"},
    {"id": "G4", "set": "G", "scope": "p", "paths": ["state/*.tmp"], "mode": "skip", "orphan": true, "reason": "orphans of an interrupted write"},
    {"id": "B15", "set": "B", "scope": "h", "paths": ["work/impl-diff*.txt", "work/base-slice/**", "work/context-bundle.json", "work/mr-*", "work/sources/**/mr-*", "work/context-bundle.lines.md", "work/user-path-failures.json"], "mode": "skip", "reason": "product code: the change under test or lines of the application's source (CL3-3; the product's code stays out of the archive)"},
    {"id": "B16", "set": "B", "scope": "h", "paths": ["work/handoffs/**", "work/review-receipts/*.json", "work/windows/*.json", "work/digests/**", "work/briefs/*.md", "state/driver-tmp/**", "state/window-files/**", "work/proposals/**", "state/walks/*", "state/walks/*/batches/**", "work/walks/**", "work/place-answers/**"], "mode": "new", "reason": "the process carriers an investigation reads: handoffs, review receipts, critic windows, digests, briefs, driver packets, proposals"},
    {"id": "B17", "set": "B", "scope": "h", "paths": ["work/s5-plan.json", "work/s5-plan.prev.json", "work/s5-plan-reviews.json", "work/sizing.json", "work/s5-notes.md", "work/s5-notes/**", "work/finalization-receipt.json", "work/review-debts.json", "work/blast-radius.json", "work/flow-requests.json", "state/dashboard-deferred.json", "state/projection-stale.json", "state/environment-projection-stale.json", "state/manifest-projection-stale.json", "work/waivers.json", "state/test-repo-base.json", "state/first-look-attempt.json", "state/config-at-start.json", "state/migration-intent.json", "state/migration/**"], "mode": "copy"},
    {"id": "B18", "set": "B", "scope": "h", "paths": ["state/passed-by-person.jsonl"], "mode": "tail"},
    {"id": "B19", "set": "B", "scope": "h", "paths": ["state/walks/*/sessions/**"], "mode": "skip", "reason": "browser profiles of a kept walk session: the product's cookies and data stay out of the archive"},
    {"id": "B20", "set": "B", "scope": "h", "paths": ["state/driver-timings.jsonl"], "mode": "tail"},
    {"id": "E8", "set": "E", "scope": "h", "paths": ["work/requirements-register.md", "work/triage*.json", "work/triage-in/**", "work/test-code/**", "work/run-report.json", "work/traceability.json", "work/grounding.yaml", "work/reference-snapshot.yaml", "work/source-inventory.json", "work/ticket-*.md", "work/ticket-*.json", "work/sources/**", "work/*fragment*.json", "work/scope-card.md", "work/readiness.json", "work/case-actions.json", "work/regression-recommendations.json", "work/case-appendix.md", "state/story-case-links.json", "state/plan-baseline.json", "work/judge-*.json", "work/probe-debt.json", "work/probe-debt/**", "work/probe-debt-memory.json", "work/ticket-raw/**", "work/sensitivity-receipts/**", "work/delivery-summary.*", "work/mutation-reconciliation.json", "work/verification-gaps.json", "work/gap-classes.json", "work/estimate-facts.json", "work/tms-publication-*.json", "work/first-look.yaml"], "mode": "new", "reason": "the records an investigation reads: the register, triage, test-code critic findings, ticket text"},
    {"id": "E9", "set": "E", "scope": "h", "paths": ["work/bug-drafts/**", "work/bug-text/**", "state/findings/**", "state/decisions/**", "work/probes/**", "work/probe-models/**", "work/probe-requests/**", "work/s7-reorder/**"], "mode": "new", "reason": "drafts, probe records and the S7 test-file snapshot (test code the factory wrote)"},
    {"id": "E10", "set": "E", "scope": "h", "paths": ["work/exploratory-findings.jsonl"], "mode": "tail"},
    {"id": "E11", "set": "E", "scope": "h", "paths": ["work/blobs/**"], "mode": "index", "reason": "ticket attachments (images, PDFs): the index only"},
    {"id": "E12", "set": "E", "scope": "h", "paths": ["state/report-history/*.md", "test-report.md", "interim-report.md"], "mode": "copy", "reason": "the report text and its history: the factory's own text"},
    {"id": "A13", "set": "A", "scope": "p", "paths": ["state/words/**"], "mode": "new"},
    {"id": "A14", "set": "A", "scope": "p", "paths": ["state/integrations/jira-direct-probe.json", "state/integrations/tracker-write.json", "state/stand-*.json"], "mode": "copy"},
    {"id": "A15", "set": "A", "scope": "p", "paths": ["state/config-reverts/**"], "mode": "skip", "orphan": true, "reason": "a config backup; the current config is in the copy"},
    {"id": "D4", "set": "D", "scope": "p", "paths": ["state/decision-transactions/**"], "mode": "new"},
    {"id": "E13", "set": "E", "scope": "p", "paths": ["records/coverage-map.md", "state/coverage-map.md", "state/coverage-map.receipt.json"], "mode": "copy"},
    {"id": "H1", "set": "H", "scope": "p", "virtual": "gap", "mode": "skip", "gap": "none: the packer draws set H from the stall and loop rules", "reason": "set H has no path of this table: the packer asks collect_stall for each story's stall and loop verdicts and packs the transcripts of a stalled or looping story into their own file"}
  ]
}
