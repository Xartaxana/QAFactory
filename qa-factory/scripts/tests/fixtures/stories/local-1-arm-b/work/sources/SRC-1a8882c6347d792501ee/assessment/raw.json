hes": {"self": "https://example.invalid/41", "watchCount": 1, "isWatching": false}, "customfield_30605": null, "customfield_30606": null, "customfield_23518": null, "customfield_30607": null, "customfield_30602": null, "customfield_12200": null, "customfield_30603": null, "customfield_30604": null, "customfield_34405": {"self": "https://example.invalid/42", "value": "Undefined", "id": "50316", "disabled": false}, "customfield_14500": null, "customfield_12203": null, "customfield_30600": null, "customfield_11900": null, "customfield_34895": null, "customfield_40400": null, "customfield_37000": 0.0, "customfield_40401": null, "updated": "2026-10-13T11:41:28.632+0000", "customfield_25700": "2|iheygk:", "customfield_16110": null, "timeoriginalestimate": null, "customfield_30612": null, "customfield_32911": null, "customfield_30613": null, "description": "*Objective:* Verify that a signed-in user can add an in-stock book to the cart with quantity 1 and see the correct line in the cart.\n\n*Type:* positive  \n*Level:* end-to-end  \n*Priority:* critical\n\n*Preconditions:*\n* Application is reachable (local disposable environment)\n* A regular user account is available\n* Books are located by title via catalog search, never by ID, because IDs change when the database is reseeded\n* Book \"1984\" is in stock (stock >= 1) at $13.99; read the real price and stock at run time\n\n*Test data:*\n* Book: 1984\n* Price: $13.99\n* Quantity: 1\n\n*Steps & Expected results:*\n# Open the login page and sign in with the regular user account  \n   *Expected:* User lands on the catalog page; the Logout button is visible\n# Open the cart; remove every line that is present  \n   *Expected:* Cart is empty; the cart badge in the navigation is absent or 0\n# On the catalog page type \"1984\" into the search box and click Search  \n   *Expected:* A catalog card titled \"1984\" is listed\n# Open the detail page of \"1984\"  \n   *Expected:* Detail page opens with heading \"1984\" and price $13.99\n# Check the Quantity field  \n   *Expected:* Value is 1\n# Click Add to Cart  \n   *Expected:* Cart badge in the navigation shows 1\n# Open the cart  \n   *Expected:* Exactly one line \"1984\" is listed\n# Read the line quantity, price and subtotal  \n   *Expected:* Quantity 1, price $13.99, subtotal $13.99\n\n*Postconditions:*\n* Cart contains one line \"1984\" with quantity 1 and subtotal $13.99\n* Cart is emptied afterwards\n\n*Traceability:*\n* User story: REF-6", "customfield_38105": {"self": "https://example.invalid/43", "value": "Negligible", "id": "101770", "disabled": false}, "customfield_19501": null, "customfield_30610": null, "customfield_33325": null, "timetracking": {}, "customfield_30611": null, "customfield_34899": {"self": "https://example.invalid/44", "value": "No", "id": "51126", "disabled": false}, "customfield_33334": ["person-2@example.invalid(person-3)"], "customfield_34423": {"self": "https://example.invalid/45", "value": "Example", "id": "50322", "disabled": false}, "customfield_33335": null, "customfield_34545": null, "customfield_15816": "0.0", "customfield_10800": "9223372036854775807", "customfield_33333": "9223372036854775807", "customfield_34422": {"self": "https://example.invalid/46", "value": "No", "id": "50320", "disabled": false}, "customfield_34541": null, "customfield_20600": null, "customfield_22900": null, "summary": "Add in-stock book to cart with quantity 1", "customfield_30502": null, "customfield_30503": null, "customfield_10001": null, "customfield_10002": null, "customfield_34549": null, "customfield_30500": null, "customfield_33336": {"self": "https://example.invalid/47", "value": "Open", "id": "45742", "disabled": false}, "customfield_10004": null, "environment": null, "customfield_33100": "N/A", "duedate": null, "customfield_40301": null, "comment": {"comments": [], "maxResults": 1000, "total": 0, "startAt": 0}, "customfield_40300": "", "customfield_15120": null, "customfield_17303": null, "fixVersions": [], "custom